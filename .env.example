# Optional: GitHub Pages project path, e.g. /stashfound
# NEXT_PUBLIC_BASE_PATH=

# Cloudflare Worker that fetches PoE Ladder uniques. Empty disables live import.
# Local default is http://127.0.0.1:8787 (npm run worker).
NEXT_PUBLIC_IMPORT_URL=http://127.0.0.1:8787

# Optional Cloudflare Turnstile (must match TURNSTILE_SECRET on the Worker)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional override if auto-detect of the current challenge league is wrong
# POE_SSF_LEAGUE=SSF Allflame
# POE_NINJA_OVERVIEW=allflame
# POE_LADDER_IDENTIFIER=SSF_Curse_of_the_Allflame
